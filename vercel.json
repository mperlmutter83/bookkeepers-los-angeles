{
  "redirects": [
    {
      "source": "/blog/:slug((?!page$).+)",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/index.php/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ]
}
